{
	"name": "turbo-starter",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "turbo start",
		"clean": "node scripts/clean.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"check-types": "turbo check-types",
		"test:e2e": "pnpm --filter web test:e2e",
		"storybook": "pnpm --filter web storybook",
		"build:storybook": "turbo run build:storybook",
		"test": "turbo run test",
		"docker": "docker compose up --build -d --remove-orphans",
		"docker:build": "docker compose build",
		"prepare": "lefthook install"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		],
		"overrides": {
			"postcss": "^8.5.23"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.9",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=24.13.0"
	},
	"volta": {
		"node": "24.13.0",
		"pnpm": "10.28.1"
	}
}
