{
	"mcpServers": {
		"next-devtools": {
			"command": "npx",
			"args": ["-y", "next-devtools-mcp@latest"]
		},
		"shadcn": {
			"command": "npx",
			"args": ["shadcn@latest", "mcp"]
		},
		"storybook": {
			"type": "http",
			"url": "http://localhost:6006/mcp"
		},
		"webstorm": {
			"url": "http://127.0.0.1:64894/stream",
			"type": "http"
		}
	}
}
