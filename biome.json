{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn"
			},
			"style": {
				"useTemplate": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true
		}
	},
	"json": {
		"parser": {
			"allowComments": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"overrides": [
		{
			"includes": ["**/apps/web/**"],
			"linter": {
				"rules": {
					"a11y": {
						"preset": "recommended"
					},
					"correctness": {
						"useJsxKeyInIterable": "error"
					}
				}
			}
		},
		{
			"includes": ["**/packages/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"preset": "recommended",
						"useKeyWithClickEvents": "error",
						"useValidAnchor": "error"
					},
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		},
		{
			"includes": ["**/packages/ui/src/components/**", "**/packages/ui/src/hooks/**", "**/packages/ui/src/lib/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useFocusableInteractive": "off",
						"useKeyWithClickEvents": "off",
						"useSemanticElements": "off",
						"noNoninteractiveTabindex": "off",
						"noRedundantRoles": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": {
							"level": "error",
							"options": { "reportUnnecessaryDependencies": false }
						}
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noDoubleEquals": "off"
					}
				}
			}
		}
	]
}
